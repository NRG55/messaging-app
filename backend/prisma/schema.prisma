generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id           String    @id @default(uuid())
    username     String    @unique
    password     String
    avatarUrl    String?
    bio          String?

    createdAt    DateTime  @default(now())
    lastSeen     DateTime  @default(now())

    messages     Message[]
    memberships  ChatMember[]

    @@index([lastSeen])
}

model Chat {
    id           String   @id @default(uuid())
    type         ChatType
    name         String?
    createdAt    DateTime @default(now())

    hash         String? @unique // for DIRECT chats to prevent race conditions during find or create chat 

    members      ChatMember[]
    messages     Message[]
}

enum ChatType {
    DIRECT
    GROUP
    PUBLIC
}

model ChatMember {
    id           String   @id @default(uuid())
    userId       String
    chatId       String
    createdAt    DateTime @default(now())

    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    chat         Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

    @@unique([userId, chatId])
}

model Message {
    id           String   @id @default(uuid())
    chatId       String
    senderId     String
    text         String
    imageUrl     String?
    createdAt    DateTime @default(now())

    sender       User     @relation(fields: [senderId], references: [id], onDelete: Cascade)    
    chat         Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
}