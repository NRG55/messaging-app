generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id         String     @id @default(uuid())
    username   String     @unique
    password   String
    avatarUrl  String?
    bio        String?    @db.VarChar(160)
    createdAt  DateTime   @default(now())
}