generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id                 String   @id @default(uuid())
    username           String   // saved in original casing (example: "JohnDoe") to show on the frontend
    normalizedUsername String   @unique // saved in lowercase (e.g., "johndoe") to prevent duplicate accounts
    password           String
    createdAt          DateTime @default(now())
}